# Reference only: pi-otel does not load .env files automatically.
# Prefer `/otel setup` inside pi; these variables override the saved settings.
# Source trusted shell configuration or export these variables before starting pi.
PI_OTEL_ENDPOINT=https://adoption.entaina.ai/api
PI_OTEL_TOKEN=replace-with-adoption-token

# Required for account tokens; optional/ignored by Adoption for personal tokens.
PI_OTEL_USER_EMAIL=you@example.com
OTEL_SERVICE_NAME=pi

# Full content, including images and provider-visible reasoning, is the default.
PI_OTEL_CAPTURE_CONTENT=true
PI_OTEL_CAPTURE_STREAM=true
PI_OTEL_REPLAY_HISTORY=true

# Optional batching and transport configuration.
PI_OTEL_BATCH_SIZE=100
PI_OTEL_FLUSH_INTERVAL_MS=1000
PI_OTEL_TIMEOUT_MS=10000
PI_OTEL_SHUTDOWN_TIMEOUT_MS=5000
